# KrishiOpt AI — Environment Configuration Example
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Key for Krishi AI Assistant
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key for Interactive Agricultural Map
# Required APIs: Maps JavaScript API, Places API, Geocoding API
# Get your key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server Configuration
PORT=5000
FLASK_DEBUG=false
